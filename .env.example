# ===== PRODUCTION ====
# Copy file ini ke .env.production, isi semua nilai.
# Letakkan .env.production di VPS (jangan di-commit).
#
# NEXT_PUBLIC_SITE_URL harus pakai domain production:
#   NEXT_PUBLIC_SITE_URL=https://domain-anda.com
#
# MIDTRANS_IS_PRODUCTION=true untuk transaksi live.
# SETUP_SECRET_KEY = ganti dengan string acak kuat (min 32 karakter).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=your-secret-key
NEXT_PUBLIC_SUPABASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SETUP_SECRET_KEY=change-this-before-production
CRON_SECRET=change-this-to-a-random-secret
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_MERCHANT_ID=your-merchant-id
MIDTRANS_IS_PRODUCTION=false
